# Groundplan API. Build from the repo root:  docker build -f infra/Dockerfile.api -t groundplan-api .
# Layout inside the image mirrors the repo (/app/backend, /app/fixtures) because the engine reads
# fixtures/engine/states.json relative to the package.
FROM python:3.13-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.7.22 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app/backend
COPY backend/pyproject.toml backend/uv.lock backend/README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/ ./
RUN uv sync --frozen --no-dev

FROM python:3.13-slim
RUN useradd --system --uid 10001 --home /app groundplan
WORKDIR /app/backend
COPY --from=build --chown=groundplan /app/backend /app/backend
COPY --chown=groundplan fixtures/engine /app/fixtures/engine
ENV PATH="/app/backend/.venv/bin:$PATH" PYTHONUNBUFFERED=1 GP_RETAIN_UPLOADS_SECONDS=0
USER groundplan
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request,sys; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health'); sys.exit(0)"
# migrations run as a one-off task (see ecs-task-def.json "migrate" note); the web task only serves
CMD ["uvicorn", "groundplan.api:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
