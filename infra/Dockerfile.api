# Groundplan Python API (gp-python-api). Build from the repo root:
#   docker build -f infra/Dockerfile.api --build-arg GP_GIT_SHA=$(git rev-parse --short=12 HEAD) -t gp-python-api .
# Layout mirrors the repo (/app/backend, /app/pipeline, /app/fixtures): the engine reads fixtures/engine/states.json
# relative to the package and gp_pipeline is a uv path dependency (../pipeline). In production the pipeline runs in its
# own container (GP_PIPELINE_URL); the in-process fallback is there for local dev and would need tesseract here.
FROM python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.7.22 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never UV_PYTHON=python3.12
COPY pipeline/ /app/pipeline/
WORKDIR /app/backend
COPY backend/pyproject.toml backend/uv.lock backend/README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/ ./
RUN uv sync --frozen --no-dev --no-editable

FROM python:3.12-slim
ARG GP_GIT_SHA=""
RUN useradd --system --uid 10001 --home /app groundplan
WORKDIR /app/backend
COPY --from=build --chown=groundplan /app/backend /app/backend
COPY --chown=groundplan fixtures/engine /app/fixtures/engine
COPY --chown=groundplan fixtures/documents/eval-latest.json /app/fixtures/documents/eval-latest.json
ENV PATH="/app/backend/.venv/bin:$PATH" PYTHONUNBUFFERED=1 GP_RETAIN_UPLOADS_SECONDS=0 GP_GIT_SHA=$GP_GIT_SHA
USER groundplan
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request,sys; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health'); sys.exit(0)"
# Box B: migrate then serve (1 worker; 256 MB cap). On ECS the migration is a one-off task (ecs-task-def.json).
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn groundplan.api:app --host 0.0.0.0 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips '*'"]
