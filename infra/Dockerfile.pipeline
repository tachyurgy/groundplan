# gp-pipeline: the internal document-extraction service (SPEC §8). No public route, no database, no disk writes.
#   docker build -f infra/Dockerfile.pipeline -t gp-pipeline .
FROM python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.7.22 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never UV_PYTHON=python3.12
WORKDIR /app/pipeline
COPY pipeline/pyproject.toml pipeline/uv.lock pipeline/README.md ./
RUN uv sync --frozen --no-dev --extra service --no-install-project
COPY pipeline/gp_pipeline ./gp_pipeline
RUN uv sync --frozen --no-dev --extra service --no-editable

FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng poppler-utils \
    && rm -rf /var/lib/apt/lists/* && useradd --system --uid 10001 --home /app gp
COPY --from=build --chown=gp /app/pipeline/.venv /app/pipeline/.venv
WORKDIR /app/pipeline
ENV PATH="/app/pipeline/.venv/bin:$PATH" PYTHONUNBUFFERED=1 OMP_THREAD_LIMIT=1
USER gp
EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request,sys; urllib.request.urlopen('http://127.0.0.1:8090/health'); sys.exit(0)"
CMD ["uvicorn", "gp_pipeline.service:app", "--host", "0.0.0.0", "--port", "8090", "--workers", "1"]
